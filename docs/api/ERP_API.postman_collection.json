            "auth": {
              "type": "noauth"
            },
            "description": "Con \"role\": \"vendedor\" el token se emite con la habilidad rol:vendedor. Se guarda en {{token_supervisor}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_supervisor}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\",\n  \"role\": \"vendedor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.5 Login con contraseña incorrecta (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable: credenciales incorrectas', () => pm.response.to.have.status(422));",
                  "pm.test('Mensaje «Credenciales incorrectas.» en el campo email', () => {",
                  "    pm.expect(pm.response.json().errors.email[0]).to.eql('Credenciales incorrectas.');",
                  "});"
                ]
