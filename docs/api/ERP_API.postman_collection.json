  "item": [
    {
      "name": "1. Autenticación",
      "description": "Login por token (Sanctum) con rol activo, errores de credenciales y consulta del usuario.",
      "item": [
        {
          "name": "1.1 Login vendedor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created: se emitió el token', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('La respuesta trae token, token_type Bearer y rol_activo', () => {",
                  "    pm.expect(r.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(r.token_type).to.eql('Bearer');",
                  "    pm.expect(r.rol_activo).to.eql('vendedor');",
                  "});",
                  "pm.collectionVariables.set('token_vendedor', r.token); // se usa en las siguientes peticiones"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Devuelve un token Bearer. El script lo guarda en la variable {{token_vendedor}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_vendedor}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.2 Login almacenista",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created: se emitió el token', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('La respuesta trae token, token_type Bearer y rol_activo', () => {",
                  "    pm.expect(r.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(r.token_type).to.eql('Bearer');",
                  "    pm.expect(r.rol_activo).to.eql('almacenista');",
                  "});",
                  "pm.collectionVariables.set('token_almacenista', r.token); // se usa en las siguientes peticiones"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Token del almacenista (no tiene permiso para vender). Se guarda en {{token_almacenista}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_almacenista}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.3 Login supervisor SIN rol (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable: falta el rol', () => pm.response.to.have.status(422));",
                  "pm.test('El error está en el campo role y menciona los roles', () => {",
                  "    const e = pm.response.json().errors;",
                  "    pm.expect(e).to.have.property('role');",
                  "    pm.expect(e.role[0]).to.include('vendedor').and.include('almacenista');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "El supervisor tiene dos roles: si no indica «role», la API lo pide.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_supervisor}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.4 Login supervisor CON rol vendedor",
          "event": [
            {
              "listen": "test",
              "script": {
