            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Credenciales inválidas: 422 con el error en el campo email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_vendedor}}\",\n  \"password\": \"clave-equivocada\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.6 Mi usuario (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Es el vendedor con su rol activo', () => {",
                  "    pm.expect(r.email).to.eql(pm.variables.get('email_vendedor'));",
                  "    pm.expect(r.rol_activo).to.eql('vendedor');",
                  "});",
                  "pm.test('Puede crear ventas pero no compras', () => {",
                  "    pm.expect(r.permisos).to.include('crear-ventas');",
                  "    pm.expect(r.permisos).to.not.include('crear-compras');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vendedor}}",
                  "type": "string"
                }
              ]
            },
            "description": "Quién soy y qué puedo hacer: permisos efectivos = rol activo + permisos directos."
          }
        }
      ]
    },
    {
      "name": "2. Productos",
      "description": "Consulta del catálogo: paginación, búsqueda, detalle, 404 y 401.",
      "item": [
        {
          "name": "2.1 Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Respuesta paginada: data, links y meta', () => {",
                  "    pm.expect(r.data).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(r).to.have.property('links');",
                  "    pm.expect(r.meta).to.have.property('total');",
                  "});",
                  "pm.test('Cada producto expone solo los campos del ProductResource', () => {",
                  "    r.data.forEach(p => pm.expect(p).to.have.all.keys('id', 'nombre', 'descripcion', 'precio', 'stock', 'disponible', 'categoria'));",
                  "});",
                  "const conStock = r.data.find(p => p.disponible && p.stock > 0);",
                  "pm.test('Hay al menos un producto con stock para vender', () => pm.expect(conStock).to.not.be.undefined);",
                  "if (conStock) {",
                  "    pm.collectionVariables.set('product_id', conStock.id);",
                  "    pm.collectionVariables.set('product_stock', conStock.stock);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?per_page=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "50"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vendedor}}",
                  "type": "string"
                }
              ]
            },
            "description": "Lista paginada (data, links y meta). Guarda en {{product_id}} el primer producto con stock para usarlo en la venta."
          }
        },
        {
          "name": "2.2 Buscar productos por nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const term = pm.request.url.query.get('search').toLowerCase();",
                  "pm.test('Todos los resultados contienen «' + term + '»', () => {",
                  "    pm.response.json().data.forEach(p => pm.expect(p.nombre.toLowerCase()).to.include(term));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?search=mouse",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "mouse"
