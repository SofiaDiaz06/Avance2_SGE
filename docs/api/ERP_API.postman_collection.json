    {
      "name": "3. Ventas",
      "description": "Registrar y consultar ventas con las mismas reglas de la web (StoreSaleRequest + SaleService).",
      "item": [
        {
          "name": "3.1 Crear venta (vendedor)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha de hoy en formato AAAA-MM-DD para el campo sale_date",
                  "pm.collectionVariables.set('hoy', new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json().data;",
                  "pm.test('Número de factura secuencial FV-00000', () => pm.expect(v.factura).to.match(/^FV-\\d{5}$/));",
                  "pm.test('Total = subtotal + IVA (19 %)', () => {",
                  "    pm.expect(v.iva).to.be.closeTo(v.subtotal * 0.19, 0.01);",
                  "    pm.expect(v.total).to.be.closeTo(v.subtotal + v.iva, 0.01);",
                  "});",
                  "pm.test('El detalle trae el producto vendido', () => {",
                  "    pm.expect(v.detalle[0].producto_id).to.eql(Number(pm.collectionVariables.get('product_id')));",
                  "    pm.expect(v.detalle[0].cantidad).to.eql(1);",
                  "});",
                  "pm.test('Incluye el enlace al PDF de la factura', () => pm.expect(v.pdf).to.include('/sales/' + v.id + '/pdf'));",
                  "pm.collectionVariables.set('sale_id', v.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sales",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sales"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_vendedor}}",
                  "type": "string"
                }
              ]
            },
            "description": "Registra una venta de 1 unidad del producto {{product_id}}. Guarda {{sale_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": {{client_id}},\n  \"sale_date\": \"{{hoy}}\",\n  \"notes\": \"Venta desde Postman (Clase 13)\",\n  \"items\": [\n    {\n      \"product_id\": {{product_id}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3.2 Ver venta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const v = pm.response.json().data;",
                  "pm.test('Es la venta creada, con cliente y vendedor', () => {",
                  "    pm.expect(v.id).to.eql(Number(pm.collectionVariables.get('sale_id')));",
                  "    pm.expect(v.cliente).to.have.property('nombre');",
