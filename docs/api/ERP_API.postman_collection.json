{
  "info": {
    "name": "ERP Distribuidora Tecnológica - API v1 (Clase 13)",
    "description": "Pruebas de la API REST del ERP (Laravel Sanctum).\n\nEjecutar en orden con el Collection Runner: cada login guarda su token y las peticiones siguientes lo usan. Todas las peticiones tienen pruebas automáticas (pestaña Tests / Scripts → Post-response).\n\nImportante: el login permite máximo 5 intentos por minuto; la colección hace 5. Si se vuelve a ejecutar antes de un minuto, los login responden 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Prueba común a todas las peticiones",
          "pm.test('La respuesta es JSON (se envió Accept: application/json)', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "// 429: el login permite 5 intentos por minuto (throttle:5,1). Mensaje claro en el Runner",
          "if (pm.response.code === 429) {",
          "    pm.test('429 Too Many Requests: espere 1 minuto antes de volver a ejecutar los login', () => {",
          "        pm.expect.fail('Límite de peticiones alcanzado (throttle). Espere 60 segundos y repita.');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/api/v1"
    },
    {
      "key": "email_vendedor",
      "value": "vendedor@test.com"
    },
    {
      "key": "email_almacenista",
      "value": "almacenista@test.com"
    },
    {
      "key": "email_supervisor",
      "value": "supervisor@test.com"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "client_id",
      "value": "1"
    },
    {
      "key": "token_invalido",
      "value": "999|token-inventado"
    },
    {
      "key": "token_vendedor",
